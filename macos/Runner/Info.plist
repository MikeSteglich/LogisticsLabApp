<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- scenarios (.llab) of the app - opened with a double click; the files of LogisticsLab 5 imported -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>LogisticsLab-Szenario</string>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>de.th-wildau.logisticslab.llab</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>LogisticsLab 5</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>de.th-wildau.logisticslab.old</string>
			</array>
		</dict>
	</array>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.th-wildau.logisticslab.llab</string>
			<key>UTTypeDescription</key>
			<string>LogisticsLab-Szenario</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>llab</string>
				</array>
			</dict>
		</dict>
		<!-- solutions (.llsol): a known type - else the save panel adds the extension to a name that has it -->
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.th-wildau.logisticslab.llsol</string>
			<key>UTTypeDescription</key>
			<string>LogisticsLab-Lösung</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>llsol</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>de.th-wildau.logisticslab.old</string>
			<key>UTTypeDescription</key>
			<string>LogisticsLab 5</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.plain-text</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>tppx</string>
					<string>tspx</string>
					<string>clpx</string>
					<string>dlpx</string>
					<string>nwfx</string>
					<string>vrpx</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
